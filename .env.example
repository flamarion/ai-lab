# Ollama
OLLAMA_HOST=http://192.168.1.178:11434
OLLAMA_MODEL=mistral:7b

# Smart routing (used when "Auto" is selected in the UI)
ROUTE_CODE_MODEL=qwen3.5:27b
ROUTE_DEFAULT_MODEL=mistral:7b
ROUTE_TOOLS_MODEL=qwen3.5:27b

# W&B Weave tracing (set to false to disable, e.g. when handling private data)
WEAVE_ENABLED=true
WANDB_API_KEY=your-wandb-api-key-here
WANDB_PROJECT=ai-lab

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_URL=http://localhost/api

# Embedding model (for RAG)
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe

# Postgres (ai-data VM)
DATABASE_URL=postgresql://ailab:ailab_dev@192.168.1.202:5432/ailab
POSTGRES_PASSWORD=ailab_dev

# MCP (Model Context Protocol — tool servers)
# MCP_CONFIG_PATH=/app/mcp_servers.json  # override default config path

# Qdrant (vector search on ai-data VM)
QDRANT_HOST=192.168.1.202
QDRANT_PORT=6333
QDRANT_COLLECTION=ai-lab-docs

# Embedding model dimension (must match OLLAMA_EMBED_MODEL output)
EMBED_DIMENSION=768

# Context management (token budget for conversation — leave room for response)
CONTEXT_LIMIT=28000

# SearXNG (web search — gateway calls this URL internally)
SEARXNG_URL=http://searxng:8080
