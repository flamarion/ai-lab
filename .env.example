# ─── Traefik ─────────────────────────────────────────────────────────────────
TRAEFIK_HOST=traefik.lab.local
TRAEFIK_DASHBOARD_PORT=8080

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=ollama.lab.local
OLLAMA_PORT=11434
# Uncomment the following line to pull a default model on startup
# OLLAMA_MODELS=llama3.2:3b

# ─── Open WebUI ───────────────────────────────────────────────────────────────
OPEN_WEBUI_HOST=chat.lab.local
OPEN_WEBUI_PORT=3000
# Generate a random secret: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-use-openssl-rand-hex-32

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_HOST=minio.lab.local
MINIO_CONSOLE_HOST=minio-console.lab.local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_HOST=prometheus.lab.local
PROMETHEUS_PORT=9090

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_HOST=grafana.lab.local
GRAFANA_PORT=3100
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password

# ─── Network ──────────────────────────────────────────────────────────────────
# Set to your home lab host IP (used for /etc/hosts entries)
LAB_HOST_IP=192.168.1.100
